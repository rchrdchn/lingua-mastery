{
  "name": "lingua-mastery",
  "private": true,
  "version": "0.1.0",
  "description": "Mastery-gated language learning (Mandarin, Spanish, English, French, Italian, Portuguese, German). Static site + in-browser engine.",
  "scripts": {
    "data:fetch": "node scripts/data/fetch.mjs",
    "data:build": "node scripts/data/build-packs.mjs",
    "data": "npm run data:fetch && npm run data:build",
    "engine": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/test.mjs",
    "build": "npm run typecheck && npm run engine && eleventy --quiet && node scripts/postbuild.mjs",
    "dev": "npm run engine && eleventy --serve --quiet",
    "check": "node scripts/check.mjs && node scripts/inlinks.mjs", "serve": "node scripts/serve.mjs 8080",
    "verify": "node scripts/verify.mjs",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "esbuild": "^0.28.2",
    "hanzi-writer": "^3.7.3",
    "hanzi-writer-data": "^2.0.1",
    "playwright": "^1.64.1",
    "ts-fsrs": "^5.4.2",
    "typescript": "^7.0.2"
  }
}
