<!doctype html><html lang="{{ htmlLang or 'en' }}" data-av="{{ audioV | dump }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
{% set st = title | seoTitle %}{% set sd = description | seoDesc %}<title>{{ st }}</title><meta name="description" content="{{ sd }}"><link rel="canonical" href="{{ site.url }}{{ page.url }}"><meta name="theme-color" content="#0f7a5c">
<link rel="icon" href="/favicon.svg" type="image/svg+xml"><link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png"><link rel="apple-touch-icon" href="/apple-touch-icon.png"><link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }}: new lessons" href="/feed.xml"><link rel="help" type="text/plain" href="/llms.txt" title="llms.txt">
<meta property="og:site_name" content="{{ site.name }}"><meta property="og:title" content="{{ st }}"><meta property="og:description" content="{{ sd }}"><meta property="og:type" content="website"><meta property="og:url" content="{{ site.url }}{{ page.url }}"><meta property="og:image" content="{{ site.url }}/og.png"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:alt" content="{{ site.name }}: {{ site.tagline }}"><meta name="twitter:card" content="summary_large_image"><meta name="twitter:image" content="{{ site.url }}/og.png">
{% if noindex %}<meta name="robots" content="noindex">{% else %}<script type="application/ld+json">{{ { url: page.url, title: title, description: description, kind: kind, items: ldItems, course: ldCourse, term: ldTerm, lesson: ldLesson, faqs: faqs } | pageGraph | safe }}</script>{% endif %}
<link rel="stylesheet" href="/assets/style.css?v={{ build.v }}">
</head><body><a class="skip" href="#main">Skip to content</a>
<header class="top"><div class="wrap row"><a class="logo" href="/" aria-label="{{ site.name }} home">{% include "logo.njk" %}</a>
<nav class="pills" aria-label="Courses">{% for p in lm.packs %}<a href="{{ p.hubUrl }}"{% if page.url.startsWith(p.hubUrl) %} aria-current="page"{% endif %}>{{ p.short }}</a>{% endfor %}</nav>
<details class="langmenu"><summary>Learn</summary><nav class="menu" aria-label="Courses (menu)">{% for p in lm.packs %}<a href="{{ p.hubUrl }}"{% if page.url.startsWith(p.hubUrl) %} aria-current="page"{% endif %}>{{ p.adj }}{% if p.id == 'en' %}<small>for es, pt, zh speakers</small>{% endif %}</a>{% endfor %}</nav></details>
<a class="btn primary small go" href="/learn/">Practice</a></div></header>
<main id="main" class="wrap">{{ content | safe }}</main>
<footer class="foot"><div class="wrap">
{% if creditsPack %}<details class="credits"><summary>Sources and licenses</summary><ul>{% for c in creditsPack.credits %}<li><a href="{{ c.url }}" rel="noopener">{{ c.name }}</a>: {{ c.note }} License: <a href="{{ c.licenseUrl }}" rel="noopener license">{{ c.license }}</a>.</li>{% endfor %}</ul><p>Example sentences: Tatoeba, credited to their authors, CC BY 2.0 FR. Word data: CC BY-SA 4.0. <a href="/credits/">All credits</a>.</p></details>{% endif %}
<div class="fgrid"><div class="fbrand"><a class="logo" href="/" aria-label="{{ site.name }} home">{% include "logo.njk" %}</a><p class="tag">Don't just learn a language. <em>Master it.</em></p>
<div class="fctas">{% if site.repoUrl %}<a class="fcta" href="{{ site.repoUrl }}" rel="noopener"><svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span>Star on GitHub</span></a>{% endif %}{% include "newsletter.njk" %}</div></div>
<nav class="fcols" aria-label="Site">
<div><h2>Learn</h2><ul>{% for p in lm.packs %}<li><a href="{{ p.hubUrl }}">{{ p.adj }}</a></li>{% endfor %}</ul></div>
<div><h2>Product</h2><ul><li><a href="/learn/">Practice</a></li><li><a href="/about/">About</a></li><li><a href="/credits/">Credits</a></li><li><a href="/feed.xml">New lessons (RSS)</a></li></ul></div>
{% if site.repoUrl %}<div><h2>Open source</h2><ul><li><a href="{{ site.repoUrl }}" rel="noopener">GitHub repo</a></li>{% if site.showFeedbackLink %}<li><a href="{{ site.repoUrl }}/issues/new/choose" rel="noopener">Report a problem</a></li>{% endif %}<li><a href="{{ site.repoUrl }}/blob/main/CONTRIBUTING.md" rel="noopener">Contribute</a></li></ul></div>{% endif %}
<div><h2>Legal</h2><ul><li><a href="/privacy/">Privacy</a></li><li><a href="/sitemap.xml">Sitemap</a></li></ul></div>
</nav></div>
<p class="fbase"><span>© {{ build.year }} {{ site.name }} contributors</span><span>Code <a href="{{ site.repoUrl }}/blob/main/LICENSE" rel="noopener license">MIT</a> · Content <a href="https://creativecommons.org/licenses/by-sa/4.0/" rel="noopener license">CC BY-SA 4.0</a></span><span>No account. Progress stays in your browser.</span></p>
</div></footer>
{% if site.cfAnalyticsToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfAnalyticsToken }}"}'></script>{% endif %}
<script type="module" src="/assets/site.js?v={{ build.v }}"></script>
{% if appScript %}<script type="module" src="/assets/{{ appScript }}?v={{ build.v }}"></script>{% endif %}
</body></html>
