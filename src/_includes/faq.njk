{% if faqs and faqs.length %}<section class="faq" id="faq" aria-labelledby="faq-h"><h2 id="faq-h">FAQ</h2><div class="qas">{% for f in faqs %}<details class="qa" style="--i:{{ loop.index0 }}"><summary><span class="q">{{ f.q }}</span><span class="pm" aria-hidden="true"></span></summary><div class="ans"><p>{{ f.a }}{% if f.link %} <a href="{{ site.repoUrl + f.link.repo if f.link.repo else f.link.href }}"{% if f.link.repo %} rel="noopener"{% endif %}>{{ f.link.text }} →</a>{% endif %}</p></div></details>{% endfor %}</div></section>{% endif %}
