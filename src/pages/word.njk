---js
{
  layout: 'base.njk',
  pagination: { data: 'lm.words', size: 1, alias: 'w', addAllPagesToCollections: true },
  permalink: data => data.w.url,
  kind: 'WebPage',
  eleventyComputed: {
    title: d => d.w.title, description: d => d.w.description, noindex: d => d.w.noindex, creditsPack: d => d.w.pack,
    ldTerm: d => ({ name: d.w.label, description: d.w.gl.map(g => g.g).join(' / '), lang: d.w.pack.target, set: `${d.w.pack.adj} ${d.w.lvName} words`, setUrl: d.w.levelUrl }),
  }
}
---
<p class="crumbs"><a href="/">Home</a> / <a href="{{ w.pack.hubUrl }}">{{ w.pack.adj }}</a> / <a href="{{ w.levelUrl }}">{{ w.lvName }}</a> / {{ w.it.t }}</p>
<section class="whero"><h1><span lang="{{ w.pack.target }}">{{ w.it.t }}</span>{% if w.it.r %}<span class="py">{{ w.it.r }}</span>{% endif %}</h1>
<button class="say big" type="button" aria-label="Listen to {{ w.it.t }}" data-say="{{ w.it.t }}" data-lang="{{ w.pack.speech }}">{% include "i-say.njk" %}</button>
<ul class="means">{% for g in w.gl %}<li>{% if w.gl.length > 1 %}<small>{{ g.b }}</small>{% endif %}{{ g.g }}</li>{% endfor %}</ul>
<ul class="tags"><li><a href="{{ w.levelUrl }}">{{ w.lvName }}</a></li><li>#{{ w.it.rank }} most used</li>{% if w.it.pos %}<li>{{ w.it.pos }}</li>{% endif %}{% if w.it.ipa %}<li>{{ w.it.ipa }}</li>{% endif %}{% if w.it.sp %}<li>said {{ w.it.sp }}</li>{% endif %}{% if w.it.alt %}<li lang="zh-Hant">trad. {{ w.it.alt }}</li>{% endif %}</ul></section>
{% if w.ex.length %}<h2>In real sentences</h2><ul class="exlist">{% for s in w.ex %}<li class="exc"><span class="s" lang="{{ w.pack.target }}">{{ s.t | hl(w.it.t) | safe }}</span><button class="say" type="button" aria-label="Listen" data-say="{{ s.t }}" data-lang="{{ w.pack.speech }}">{% include "i-say.njk" %}</button>{% for t in s.tr %}<span class="tr">{% if s.tr.length > 1 %}{{ t.name }}: {% endif %}{{ t.t }}</span>{% endfor %}<span class="credit">Tatoeba: {{ s.a }}{% for t in s.tr %}{% if t.by %} / {{ t.by }}{% endif %}{% endfor %}</span></li>{% endfor %}</ul>{% endif %}
<div class="sticky-cta"><a class="btn primary big" href="{{ w.practice }}">Practice this word</a></div>
{% if w.chars.length or (w.it.forms and w.it.forms.length) or (w.it.cl and w.it.cl.length) %}<ul class="chips">{% for c in w.chars %}<li><a href="{{ c.url }}" lang="zh">{{ c.c }}</a> <span class="muted">character</span></li>{% endfor %}{% if w.it.forms and w.it.forms.length %}<li><span class="muted">Forms:</span> <span lang="{{ w.pack.target }}">{{ w.it.forms | join(', ') }}</span></li>{% endif %}{% if w.it.cl and w.it.cl.length %}<li><span class="muted">Measure words:</span> <span lang="zh">{{ w.it.cl | join(', ') }}</span></li>{% endif %}</ul>{% endif %}
{% if w.related.length %}<h2>Learn it with</h2><ul class="chips">{% for r in w.related %}<li><a href="{{ r.url }}" lang="{{ w.pack.target }}">{{ r.t }}</a> <span class="muted">{{ r.g }}</span></li>{% endfor %}</ul>{% endif %}
<p class="pn">{% if w.prev %}<a rel="prev" href="{{ w.prev.url }}">← {{ w.prev.t }}</a>{% endif %}{% if w.next %}<a rel="next" href="{{ w.next.url }}">{{ w.next.t }} →</a>{% endif %}</p>
{% updated %}
