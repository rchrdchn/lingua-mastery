---js
{
  layout: 'base.njk',
  pagination: { data: 'lm.chars', size: 1, alias: 'ch', addAllPagesToCollections: true },
  permalink: data => data.ch.url,
  kind: 'WebPage',
  appScript: 'strokes.js',
  eleventyComputed: {
    title: d => d.ch.title, description: d => d.ch.description, noindex: d => d.ch.noindex, creditsPack: d => d.ch.pack,
    ldTerm: d => ({ name: d.ch.c.c, description: d.ch.g, lang: 'zh', set: `Chinese characters in ${d.ch.lvName}`, setUrl: d.ch.levelUrl }),
  }
}
---
<p class="crumbs"><a href="/">Home</a> / <a href="{{ ch.pack.hubUrl }}">Mandarin</a> / <a href="{{ ch.levelUrl }}">{{ ch.lvName }}</a> / {{ ch.c.c }}</p>
<h1><span lang="zh">{{ ch.c.c }}</span> <span class="py">{{ ch.c.r | join(', ') }}</span></h1>
<ul class="means"><li>{{ ch.g }}</li></ul>
<div class="strokebox"><div id="stroke" data-char="{{ ch.c.c }}" aria-label="Stroke order animation for {{ ch.c.c }}"></div><p><button class="btn small" id="replay" type="button">Replay</button> <button class="btn small" id="quiz" type="button">Try writing it</button></p></div>
<ul class="tags"><li><a href="{{ ch.levelUrl }}">{{ ch.lvName }}</a></li>{% if ch.c.strokes %}<li>{{ ch.c.strokes }} strokes</li>{% endif %}<li>{{ ch.c.g.en | first(50) }}</li></ul>
<div class="sticky-cta"><a class="btn primary big" href="{{ ch.practice }}">Practice words with {{ ch.c.c }}</a></div>
{% if ch.words.length %}<h2>Words with {{ ch.c.c }}</h2><ul class="chips">{% for x in ch.words %}<li><a href="{{ x.url }}" lang="zh">{{ x.t }}</a> <span class="muted">{{ x.r }} · {{ x.g }}</span></li>{% endfor %}</ul>{% endif %}
<p class="pn">{% if ch.prev %}<a rel="prev" href="{{ ch.prev.url }}">← {{ ch.prev.t }}</a>{% endif %}{% if ch.next %}<a rel="next" href="{{ ch.next.url }}">{{ ch.next.t }} →</a>{% endif %}</p>
{% updated %}
